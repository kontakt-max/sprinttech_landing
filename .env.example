# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=SprintTech

# Google Sheets Lead Integration (server-side only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Leads

# Google Forms Embed (optional alternative)
NEXT_PUBLIC_GOOGLE_FORM_EMBED_URL=
NEXT_PUBLIC_GOOGLE_FORM_FALLBACK_URL=

# LinkedIn
NEXT_PUBLIC_LINKEDIN_COMPANY_URL=https://www.linkedin.com/company/sprinttech
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
NEXT_PUBLIC_LINKEDIN_INSIGHT_TAG_ENABLED=false

# Soro AI SEO Webhook
SORO_WEBHOOK_ENABLED=false
SORO_WEBHOOK_API_KEY=
SORO_WEBHOOK_SECRET=
SORO_PUBLISH_MODE=draft

# Rate Limiting (optional Redis for production)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=60000

# Threat Pulse (public intel aggregator)
THREAT_PULSE_ENABLED=false
THREAT_PULSE_CACHE_TTL_HOURS=6
THREAT_PULSE_REQUEST_TIMEOUT_MS=5000
THREAT_PULSE_MAX_CVES=20
NVD_API_KEY=
PUBLIC_THREAT_SOURCES_ATTRIBUTION_ENABLED=true
SHADOWSERVER_INTEGRATION_ENABLED=false
SHADOWSERVER_API_KEY=

# Analytics (disabled by default, requires consent)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
