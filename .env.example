# =============================================================================
# SprintTech — environment variables (template)
# =============================================================================
# Copy to `.env.local` for local development:  cp .env.example .env.local
# `.env.local` is git-ignored and must NEVER be committed.
#
# The app runs locally with NO secrets — every integration below is optional and
# safely disabled when its keys are blank. Never commit real secrets here.
#
# Legend: [required] safe default applied · [optional] extra integration ·
#         [public] exposed to browser (NEXT_PUBLIC_*, no secrets) · [server] server-only
# Validation: src/lib/env.ts (public) and src/lib/env.server.ts (server, Zod).
# =============================================================================

# --- Site --------------------------------------------------------------------
# [required] [public] Absolute site URL. Default: https://sprinttech.pl
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# [required] [public] Display name. Default: SprintTech
NEXT_PUBLIC_SITE_NAME=SprintTech

# --- Public Threat Pulse -----------------------------------------------------
# [optional] [server] Master switch for the public threat-intel aggregator. Default: true
THREAT_PULSE_ENABLED=false
# [optional] [server] Cache TTL in hours. Default: 6
THREAT_PULSE_CACHE_TTL_HOURS=6
# [optional] [server] Outbound fetch timeout in ms. Default: 12000
THREAT_PULSE_REQUEST_TIMEOUT_MS=5000
# [optional] [server] Max CVEs to fetch/return. Default: 20
THREAT_PULSE_MAX_CVES=20
# [optional] [server] Show public source attribution. Default: true
PUBLIC_THREAT_SOURCES_ATTRIBUTION_ENABLED=true
# [optional] [server] NVD API key — raises NVD rate limits. Safe default: empty (disabled)
NVD_API_KEY=

# --- Google Sheets -----------------------------------------------------------
# [optional] [server] Service account email for Sheets lead sync. Safe default: empty (disabled)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# [optional] [server] Service account private key (escape newlines as \n). Safe default: empty
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# [optional] [server] Target spreadsheet ID. Safe default: empty (disabled)
GOOGLE_SHEETS_SPREADSHEET_ID=
# [optional] [server] Worksheet/tab name. Default: Leads
GOOGLE_SHEETS_SHEET_NAME=Leads

# --- Google Forms ------------------------------------------------------------
# [optional] [public] Google Forms embed URL. Safe default: empty
NEXT_PUBLIC_GOOGLE_FORM_EMBED_URL=
# [optional] [public] Google Forms fallback (open-in-new-tab) URL. Safe default: empty
NEXT_PUBLIC_GOOGLE_FORM_FALLBACK_URL=

# --- SORO AI SEO (content webhook) -------------------------------------------
# [optional] [server] Master switch for the Soro content webhook. Default: false
SORO_WEBHOOK_ENABLED=false
# [optional] [server] Soro webhook API key (X-Api-Key). Safe default: empty (disabled)
SORO_WEBHOOK_API_KEY=
# [optional] [server] Soro webhook HMAC secret. Safe default: empty (disabled)
SORO_WEBHOOK_SECRET=
# [optional] [server] Publish mode: draft-only pipeline. Default: draft
SORO_PUBLISH_MODE=draft

# --- LinkedIn ----------------------------------------------------------------
# [optional] [public] Public LinkedIn company profile URL. Default: company/sprinttech
NEXT_PUBLIC_LINKEDIN_COMPANY_URL=https://www.linkedin.com/company/sprinttech
# [optional] [public] Enable LinkedIn Insight Tag (needs marketing consent). Default: false
NEXT_PUBLIC_LINKEDIN_INSIGHT_TAG_ENABLED=false
# [optional] [server] LinkedIn OAuth credentials (server-side API). Safe default: empty (disabled)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# --- Analytics ---------------------------------------------------------------
# [optional] [public] Enable analytics (requires consent). Default: false
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# --- Optional integrations ---------------------------------------------------
# [optional] [server] Enable Shadowserver integration. Default: false
SHADOWSERVER_INTEGRATION_ENABLED=false
# [optional] [server] Shadowserver API key. Safe default: empty (disabled)
SHADOWSERVER_API_KEY=

# --- Rate limiting -----------------------------------------------------------
# [optional] [server] Max requests per window per IP. Default: 5
RATE_LIMIT_MAX_REQUESTS=5
# [optional] [server] Rate-limit window in ms. Default: 60000
RATE_LIMIT_WINDOW_MS=60000
