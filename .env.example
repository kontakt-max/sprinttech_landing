# =============================================================================
# SprintTech — environment variables
# =============================================================================
# Copy this file to `.env.local` for local development:  cp .env.example .env.local
# `.env.local` is git-ignored and must NEVER be committed.
#
# Legend:
#   [required]  app relies on this (a safe default is applied if left blank)
#   [optional]  enables an extra integration; safely disabled when blank
#   [public]    exposed to the browser (NEXT_PUBLIC_*) — MUST NOT hold secrets
#   [server]    server-side only — never shipped to the client bundle
#
# Never commit real secrets, tokens, keys or credentials to this file.
# Validation lives in `src/lib/env.ts` (public) and `src/lib/env.server.ts` (server).
# =============================================================================

# --- Site --------------------------------------------------------------------
# [required] [public] Absolute site URL (canonical/SEO). Default: https://sprinttech.pl
NEXT_PUBLIC_SITE_URL=https://sprinttech.pl
# [required] [public] Display name of the site. Default: SprintTech
NEXT_PUBLIC_SITE_NAME=SprintTech

# --- Threat Intelligence (Threat Pulse) --------------------------------------
# [optional] [server] Master switch for the public threat-intel aggregator. Default: true
THREAT_PULSE_ENABLED=true
# [optional] [server] Cache TTL for aggregated intel, in hours. Default: 6
THREAT_PULSE_CACHE_TTL_HOURS=6
# [optional] [server] Outbound fetch timeout for intel sources, in ms. Default: 12000
THREAT_PULSE_REQUEST_TIMEOUT_MS=5000
# [optional] [server] Max number of CVEs to fetch/return. Default: 20
THREAT_PULSE_MAX_CVES=20
# [optional] [server] Show public source attribution (NVD/EPSS/MITRE/...). Default: true
PUBLIC_THREAT_SOURCES_ATTRIBUTION_ENABLED=true
# [optional] [server] NVD API key — raises NVD rate limits. Safe default: empty (disabled)
NVD_API_KEY=
# [optional] [server] Enable Shadowserver integration. Default: false
SHADOWSERVER_INTEGRATION_ENABLED=false
# [optional] [server] Shadowserver API key. Safe default: empty (disabled)
SHADOWSERVER_API_KEY=

# --- Google Workspace / Google Sheets / Google Forms -------------------------
# [optional] [server] Service account email for Sheets lead sync. Safe default: empty (disabled)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# [optional] [server] Service account private key (escape newlines as \n). Safe default: empty
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# [optional] [server] Target spreadsheet ID for leads. Safe default: empty (disabled)
GOOGLE_SHEETS_SPREADSHEET_ID=
# [optional] [server] Worksheet/tab name for leads. Default: Leads
GOOGLE_SHEETS_SHEET_NAME=Leads
# [optional] [public] Google Forms embed URL (lead capture alternative). Safe default: empty
NEXT_PUBLIC_GOOGLE_FORM_EMBED_URL=
# [optional] [public] Google Forms fallback (open-in-new-tab) URL. Safe default: empty
NEXT_PUBLIC_GOOGLE_FORM_FALLBACK_URL=

# --- LinkedIn ----------------------------------------------------------------
# [optional] [public] Public LinkedIn company profile URL. Default: company/sprinttech
NEXT_PUBLIC_LINKEDIN_COMPANY_URL=https://www.linkedin.com/company/sprinttech
# [optional] [public] Enable LinkedIn Insight Tag (needs marketing consent). Default: false
NEXT_PUBLIC_LINKEDIN_INSIGHT_TAG_ENABLED=false
# [optional] [server] LinkedIn OAuth client ID. Safe default: empty (API disabled)
LINKEDIN_CLIENT_ID=
# [optional] [server] LinkedIn OAuth client secret. Safe default: empty (API disabled)
LINKEDIN_CLIENT_SECRET=
# [optional] [server] LinkedIn OAuth access token. Safe default: empty (API disabled)
LINKEDIN_ACCESS_TOKEN=

# --- Soro AI (content webhook) -----------------------------------------------
# [optional] [server] Soro webhook API key (X-Api-Key). Safe default: empty (webhook disabled)
SORO_WEBHOOK_API_KEY=
# [optional] [server] Soro webhook HMAC secret. Safe default: empty (webhook disabled)
SORO_WEBHOOK_SECRET=

# --- OpenAI Sora (video, disabled by default) --------------------------------
# [optional] [server] Enable Sora video requests. Default: false
SORA_VIDEO_ENABLED=false
# [optional] [server] OpenAI API key (required only when SORA_VIDEO_ENABLED=true). Safe default: empty
OPENAI_API_KEY=
# [optional] [server] Daily cap for Sora video requests. Default: 10
SORA_DAILY_LIMIT=10

# --- Rate limiting -----------------------------------------------------------
# [optional] [server] Max requests per window per IP. Default: 5
RATE_LIMIT_MAX_REQUESTS=5
# [optional] [server] Rate-limit window length, in ms. Default: 60000
RATE_LIMIT_WINDOW_MS=60000

# --- Analytics ---------------------------------------------------------------
# [optional] [public] Enable analytics (requires consent). Default: false
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# --- Security ----------------------------------------------------------------
# [server] NODE_ENV is managed by Next.js/your host (development|production|test).
# Do not set it manually in .env.local; it is documented here for completeness.

# --- Feature flags -----------------------------------------------------------
# Boolean flags above accept: true/false, 1/0, yes/no, on/off (case-insensitive).
#   THREAT_PULSE_ENABLED, PUBLIC_THREAT_SOURCES_ATTRIBUTION_ENABLED,
#   SHADOWSERVER_INTEGRATION_ENABLED, SORA_VIDEO_ENABLED,
#   NEXT_PUBLIC_LINKEDIN_INSIGHT_TAG_ENABLED, NEXT_PUBLIC_ANALYTICS_ENABLED
