{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SprintTech: Dev Server",
      "type": "shell",
      "command": "npm run dev:cursor",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting|next dev",
          "endsPattern": "Ready|Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "SprintTech: Full Check",
      "type": "shell",
      "command": "npm run check",
      "problemMatcher": []
    }
  ]
}
